# Contains live DB credentials
config.php

# Tracks which commit is deployed on this server (written by the
# in-admin updater); local deployment state, not part of the script
/admin/.deployed_version

# Local working screenshots, not part of the script
/screenshots/

# Private, user-submitted content (order deliverables, chat attachments,
# support tickets) -- not part of the script itself, must never be public
/order_files/*
!/order_files/.htaccess
/conversations/conversations_files/*
!/conversations/conversations_files/.gitkeep
/proposals/proposal_files/*
!/proposals/proposal_files/.gitkeep
/requests/request_files/*
!/requests/request_files/.gitkeep
/ticket_files/*
!/ticket_files/.gitkeep
